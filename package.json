{
  "name": "kousyakann-mosi-kannri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/parsers/*"
  ],
  "scripts": {
    "build:demo": "node scripts/build-demo-site.mjs",
    "test": "node scripts/run-package-tests.mjs",
    "typecheck": "node scripts/run-typecheck.mjs",
    "security": "node scripts/pii-scan.mjs --history",
    "gas:check": "node scripts/check-gas.mjs",
    "verify": "npm run typecheck && npm test && npm run gas:check && npm run security"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@types/node": "^26.6.3",
    "typescript": "5.9.3",
    "wrangler": "^4.143.0"
  },
  "engines": {
    "node": ">=22.18.0 <23"
  }
}
